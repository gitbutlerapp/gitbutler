{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": [
		"**/*",
		"!apps/lite/**/*",
		"apps/lite/scripts/**",
		"!packages/ui-react/**/*",
		"packages/ui-react/scripts/**"
	],
	"options": {
		"typeAware": true,
		"denyWarnings": true,
		"reportUnusedDisableDirectives": "warn"
	}
}
