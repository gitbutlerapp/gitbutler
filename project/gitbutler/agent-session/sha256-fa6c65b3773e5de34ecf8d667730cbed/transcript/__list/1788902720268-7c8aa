add_stack_with_segments(&mut meta, 1, \\\"top\\\", StackState::InWorkspace, &[\\\"bottom\\\"]);\\n+    let before = head_info(&repo, &meta, &mut db, standard_options())?;\\n+    let mut gerrit_db = but_testsupport::in_memory_db();\\n+    let review_url = \\\"https://gerrit.example.com/c/project/+/3\\\";\\n+    for commit in before.stacks[0].segments.iter().flat_map(|segment| &segment.commits) {\\n+        let mut metadata = gerrit_meta(commit.change_id().to_string(), commit.id, review_url);\\n+        if matches!(commit.relation, LocalCommitRelation::Integrated(_)) {\\n+            metadata.commit_id = \\\"unused for integrated commits\\\".into();\\n+        }\\n+        gerrit_db.gerrit_metadata_mut().insert(metadata)?;\\n+    }\\n+\\n+    let after = head_info(&repo, &meta, &mut db, but_workspace::ref_info::Options {\\n+        gerrit_mode: GerritMode::Enabled(gerrit_db.gerrit_metadata()),\\n+        ..standard_options()\\n+    })?;\\n+    for (before, after) in before.stacks[0].segments.iter().zip(&after.stacks[0].segments) {\\n+        assert_eq!(after.push_status, before.push_status, \\\"mixed Gerrit and integrated commits retain the Git push status\\\");\\n+        for (before, after) in before.commits.iter().zip(&after.commits) {\\n+            let relation = match before.relation {\\n+                LocalCommitRelation::LocalOnly => LocalCommitRelation::LocalAndRemote(before.id),\\n+                relation => relation,\\n+            };\\n+            assert_eq!(after.relation, relation, \\\"Gerrit preserves integration and records the empty tip as pushed\\\");\\n+            assert_eq!(after.gerrit_review_url.as_deref(), Some(review_url), \\\"integrated commits also retain their review URL\\\");\\n+        }\\n+    }\\n+    Ok(())\\n+}\\n+\\n+fn gerrit_meta(\\n*** End Patch\"));\ntext(await tools.exec_command({cmd:\"cargo fmt -p but-workspace && SNAPSHOTS=overwrite cargo test -p but-workspace squash_integration_preserves_empty_tip -- --nocapture\",yield_t