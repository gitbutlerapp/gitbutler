 reviews: Some(prs_by_head),\\n                    ..Default::default()\\n                },\\n            )?;\\n\\n            Ok(WorkspaceState {\\n                replaced_commits,\\n                head_info,\\n                checkout_conflict_occurred,\\n            })\\n        }\\n        #[cfg(feature = \\\"graph-workspace\\\")]\\n        {\\n            // The graph_workspace projection needs its own equivalent enrichment;\\n            // that is out of scope here.\\n            let _ = prs_by_head;\\n\"}}","tool_name":"exec","tool_kind":"other","tool_input":null,"source_record":{"timestamp":"2026-09-08T19:15:35.663Z","ordinal":73,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"[REDACTED:entropy]","call_id":"[REDACTED:entropy]","internal_chat_message_metadata_passthrough":{"turn_id":"[REDACTED:entropy]","create_time":1788894935.663369}}}}