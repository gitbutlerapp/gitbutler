{
	"name": "@gitbutler/ui-react",
	"description": "GitButler's React component library: the components, icons and base styles shared by Lite, `but panel` and the MCP app.",
	"private": true,
	"version": "0.0.0-dev",
	"type": "module",
	"license": "FSL-1.1-MIT",
	"exports": {
		"./storybook/*": "./.storybook/*",
		"./*": "./src/*"
	},
	"imports": {
		"#storybook/*": "./.storybook/*.ts"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit && pnpm lint:css && pnpm check:stories",
		"check:stories": "node scripts/check-stories.mjs",
		"lint:css": "stylelint \"src/**/*.css\"",
		"optimize-icons": "node scripts/optimize-icons.mjs",
		"test": "vitest run"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@tanstack/react-hotkeys": "^0.13.0",
		"@tanstack/react-virtual": "^3.14.18",
		"effect": "^3.22.2",
		"react-resizable-panels": "^4.14.5"
	},
	"peerDependencies": {
		"@gitbutler/design-core": "^10.0.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@gitbutler/design-core": "10.0.1",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/react-vite": "^10.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"jsdom": "28.1.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"stylelint": "^17.16.0",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
