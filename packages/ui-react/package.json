{
	"name": "@gitbutler/ui-react",
	"description": "GitButler's React component library: the components, icons and base styles shared by Lite, `but panel` and the MCP app.",
	"private": true,
	"version": "0.0.0-dev",
	"type": "module",
	"license": "FSL-1.1-MIT",
	"exports": {
		"./storybook/*": "./.storybook/*",
		"./*": "./src/*"
	},
	"imports": {
		"#storybook/*": "./.storybook/*.ts"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit",
