{
	"name": "@gitbutler/but-sdk",
	"version": "0.0.1",
	"description": "TypeScript types for GitButler's Rust API",
	"type": "module",
	"types": "./src/generated/linear/index.d.ts",
	"scripts": {
		"build:types": "cargo run -p but-ts -- --output ./src/generated/linear/index.d.ts",
		"build:types:graph": "cargo run -p but-ts --features graph-workspace -- --output ./src/generated/graph/index.d.ts",
		"build": "pnpm build:types && pnpm build:types:graph",
		"check": "tsc -p tsconfig.generated.json --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/gitbutlerapp/gitbutler.git",
		"directory": "packages/but-sdk"
	},
	"keywords": [
		"git",
		"gitbutler",
		"version-control",
		"typescript"
	],
	"author": "GitButler <gitbutler@gitbutler.com>",
	"license": "FSL-1.1-MIT",
	"files": [
		"./src/generated/linear/index.d.ts",
		"./src/generated/graph/index.d.ts"
	],
	"exports": {
		".": {
			"types": "./src/generated/linear/index.d.ts"
		},
		"./linear": {
			"types": "./src/generated/linear/index.d.ts"
		},
		"./graph": {
			"types": "./src/generated/graph/index.d.ts"
		}
	}
}
