{
  "semantic": {
    "background": {
      "$type": "color",
      "$value": "{ramps.gray.1}",
      "$description": "The main surface: the page, a pane, the content area. Text on it: foreground.",
      "$extensions": {
        "mode": {
          "light": "{ramps.gray.1}",
          "dark": "{ramps.gray.1}"
        }
      }
    },
    "muted": {
      "$root": {
        "$type": "color",
        "$value": "{ramps.gray.3}",
        "$description": "A quiet fill inside content: inline code, a code block, a secondary button, a footer strip. Not the window's ground, which is canvas. Text on it: foreground or muted/foreground.",
        "$extensions": {
          "mode": {
            "light": "{ramps.gray.3}",
            "dark": "{ramps.gray.3}"
          }
        }
      },
      "nested": {
        "$type": "color",
        "$value": "{ramps.gray.4}",
        "$description": "A fill one step deeper than muted, only on muted: a control inside a code block, muted's hover. Never on background.",
        "$extensions": {
          "mode": {
            "light": "{ramps.gray.4}",
            "dark": "{ramps.gray.4}"
          }
        }
      },
      "foreground": {
        "$type": "color",
        "$value": "{ramps.gray.11}",
        "$description": "Secondary text: labels, metadata, supporting copy. Reads at 4.5:1 on background and muted.",
        "$extensions": {
          "mode": {
            "light": "{ramps.gray.11}",
            "dark": "{ramps.gray.11}"
          }
        }
      }
    },
    "disabled": {
      "$type": "color",
      "$value": "{ramps.gray.3}",
      "$description": "The ground of a disabled control or a surface that's switched off. Not a hover.",
      "$extensions": {
        "mode": {
          "light": "{ramps.gray.3}",
          "dark": "{ramps.gray.3}"
        }
      }
    },
    "shadow": {
      "$type": "color",
      "$value": "#0000001a",
