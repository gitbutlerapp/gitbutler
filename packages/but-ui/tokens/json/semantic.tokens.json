    },
    "primary": {
      "muted": {
        "$type": "color",
        "$value": {
          "components": "{semantic.primary.$root}",
          "alpha": "14%"
        },
        "$description": "A 14% tint of primary for a larger area: a banner, a highlighted row. Text on it: primary/text.",
        "$extensions": {
          "mode": {
            "light": {
              "components": "{semantic.primary.$root}",
              "alpha": "14%"
